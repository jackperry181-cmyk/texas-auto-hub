<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elite Motors | Premium Cars</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, sans-serif;
}

body{
  background:#080808;
  color:white;
}

header{
  background:#111;
  padding:18px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:100;
  border-bottom:1px solid #333;
}

.logo{
  font-size:25px;
  font-weight:bold;
}

.logo span{
  color:#d4af37;
}

nav a{
  color:white;
  text-decoration:none;
  margin-left:20px;
}

.hero{
  min-height:75vh;
  padding:100px 6%;
  display:flex;
  align-items:center;
  background:
  linear-gradient(90deg,rgba(0,0,0,.95),rgba(0,0,0,.35)),
  url("https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1600&q=80")
  center/cover;
}

.hero h1{
  font-size:55px;
  max-width:650px;
  margin-bottom:20px;
}

.hero p{
  font-size:18px;
  color:#ccc;
  max-width:550px;
  line-height:1.6;
}

.btn{
  display:inline-block;
  margin-top:25px;
  padding:14px 25px;
  background:#d4af37;
  color:#000;
  text-decoration:none;
  font-weight:bold;
  border-radius:5px;
}

.section{
  padding:60px 6%;
}

.section h2{
  text-align:center;
  font-size:35px;
  margin-bottom:40px;
}

.cars{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:25px;
}

.car{
  background:#151515;
  border-radius:12px;
  overflow:hidden;
  border:1px solid #292929;
  transition:.3s;
}

.car:hover{
  transform:translateY(-7px);
}

.car img{
  width:100%;
  height:200px;
  object-fit:cover;
}

.car-info{
  padding:20px;
}

.car-info h3{
  font-size:22px;
  margin-bottom:10px;
}

.price{
  color:#d4af37;
  font-size:20px;
  font-weight:bold;
  margin:10px 0;
}

.details{
  color:#aaa;
  line-height:1.7;
}

footer{
  background:#111;
  padding:35px 6%;
  text-align:center;
  color:#999;
  margin-top:40px;
}

@media(max-width:700px){
  .hero h1{
    font-size:38px;
  }

  nav{
    display:none;
  }
}
</style>
</head>

<body>

